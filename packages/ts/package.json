{
  "name": "@polyspec/bindgen",
  "version": "0.0.1",
  "description": "Generates the bindings of a polyspec repository from its interface contract, and checks the contract",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema/interface.schema.json": "./schema/interface.schema.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
