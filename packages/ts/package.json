{
  "name": "@polyspec/binding",
  "version": "0.0.3",
  "description": "Generates the bindings of a polyspec repository from its interface contract, and checks the contract",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "binding": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/interface.schema.json": "./schema/interface.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
