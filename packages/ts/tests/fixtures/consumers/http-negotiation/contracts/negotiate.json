    { "id": "a_space_between_the_type_and_the_slash_is_invalid", "note": "a space between the type and the slash fails", "rules": ["NG-5.4", "NG-5.7"], "lines": ["text /html"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_missing_comma_between_ranges_is_invalid", "note": "two ranges without a comma fail", "rules": ["NG-5.2", "NG-5.7"], "lines": ["text/html application/json"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_nul_byte_is_invalid", "note": "a NUL byte fails", "rules": ["NG-5.7"], "lines": ["text/html\u0000"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} }
  ],
  "weigh": [
    { "id": "no_field_line_weighs_every_wildcard_candidate_one", "note": "without Accept every candidate that takes wildcards has weight 1000 from */*", "rules": ["NG-5.1", "NG-8.2", "NG-10.1"], "lines": [], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.example.post+json", "parameters": [{"name": "version", "values": ["1", "2"]}], "matching": "exact", "wildcards": false}], "weights": [{"weight": 1000, "range": 0}, {"weight": 1000, "range": 0}, {"weight": 0, "range": null}] },
    { "id": "the_any_range_weighs_both_page_types", "note": "*/* gives both page types weight 1000", "rules": ["NG-8.1", "NG-10.1"], "lines": ["*/*"], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 1000, "range": 0}, {"weight": 1000, "range": 0}] },
    { "id": "the_text_range_weighs_the_page", "note": "text/* matches text/html only", "rules": ["NG-8.1", "NG-10.2"], "lines": ["text/*"], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 1000, "range": 0}, {"weight": 0, "range": null}] },
    { "id": "the_application_range_weighs_the_page_data", "note": "application/* matches application/vnd.hyper+json only", "rules": ["NG-8.1", "NG-10.2"], "lines": ["application/*"], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 0, "range": null}, {"weight": 1000, "range": 0}] },
    { "id": "an_empty_accept_matches_no_candidate", "note": "an empty Accept matches no candidate", "rules": ["NG-5.3", "NG-10.2"], "lines": [""], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 0, "range": null}, {"weight": 0, "range": null}] },
    { "id": "each_candidate_takes_the_weight_of_its_range", "note": "each candidate takes the weight of its range", "rules": ["NG-10.1"], "lines": ["text/html;q=0.5, application/vnd.hyper+json;q=0.9"], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 500, "range": 0}, {"weight": 900, "range": 1}] },
    { "id": "the_most_specific_range_gives_the_weight", "note": "the range that names the type outweighs a heavier type range", "rules": ["NG-9.1", "NG-9.2"], "lines": ["text/html;q=0.2, text/*;q=0.9, application/vnd.hyper+json;q=0.5"], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 200, "range": 0}, {"weight": 500, "range": 2}] },
    { "id": "the_named_range_decides_wherever_it_stands", "note": "the range that names the type decides also after a type range", "rules": ["NG-9.1", "NG-9.2"], "lines": ["text/*;q=0.9, text/html;q=0.2, application/vnd.hyper+json;q=0.3"], "candidates": [{"type": "text", "subtype": "html", "parameters": [], "matching": "ignore", "wildcards": true}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "matching": "ignore", "wildcards": true}], "weights": [{"weight": 200, "range": 1}, {"weight": 300, "range": 2}] },
