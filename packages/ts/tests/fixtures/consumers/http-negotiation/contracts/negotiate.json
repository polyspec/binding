{
  "accept": [
    { "id": "no_field_line_is_the_any_range", "note": "a field without field lines is the range */* of weight 1000", "rules": ["NG-5.1"], "lines": [], "ranges": [{"type": "*", "subtype": "*", "parameters": [], "weight": 1000}] },
    { "id": "an_empty_value_is_an_empty_list", "note": "an empty field line value is the empty list", "rules": ["NG-5.3"], "lines": [""], "ranges": [] },
    { "id": "a_value_of_white_space_is_an_empty_list", "note": "a field line of spaces and tabs is the empty list", "rules": ["NG-1.5", "NG-5.3"], "lines": [" \t "], "ranges": [] },
    { "id": "a_value_of_commas_is_an_empty_list", "note": "a field line of empty list elements is the empty list", "rules": ["NG-5.3"], "lines": [" , ,, "], "ranges": [] },
    { "id": "a_range_gives_its_type_subtype_and_weight", "note": "a range gives its type, subtype and weight", "rules": ["NG-5.4", "NG-5.6"], "lines": ["text/html"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}] },
    { "id": "a_type_range_has_the_wildcard_subtype", "note": "a type range has the subtype *", "rules": ["NG-5.4"], "lines": ["text/*"], "ranges": [{"type": "text", "subtype": "*", "parameters": [], "weight": 1000}] },
    { "id": "a_token_that_holds_a_star_names_a_type", "note": "a token that holds * but is not * names a type", "rules": ["NG-2.1", "NG-5.4"], "lines": ["te*t/h*ml"], "ranges": [{"type": "te*t", "subtype": "h*ml", "parameters": [], "weight": 1000}] },
    { "id": "names_and_q_are_read_in_lower_case", "note": "type, subtype, parameter names and q are read in lower case and values keep their case", "rules": ["NG-1.2", "NG-2.2", "NG-5.5"], "lines": ["Text/HTML; Charset=UTF-8; Q=0.5"], "ranges": [{"type": "text", "subtype": "html", "parameters": [{"name": "charset", "value": "UTF-8"}], "weight": 500}] },
    { "id": "parameters_before_the_weight_are_kept", "note": "parameters before the weight are parameters of the range", "rules": ["NG-5.5"], "lines": ["application/vnd.example+json;version=2;q=0.9"], "ranges": [{"type": "application", "subtype": "vnd.example+json", "parameters": [{"name": "version", "value": "2"}], "weight": 900}] },
    { "id": "parameters_keep_their_order", "note": "parameters keep the order of the value", "rules": ["NG-3.6"], "lines": ["application/vnd.example+json;version=2;charset=utf-8"], "ranges": [{"type": "application", "subtype": "vnd.example+json", "parameters": [{"name": "version", "value": "2"}, {"name": "charset", "value": "utf-8"}], "weight": 1000}] },
    { "id": "a_parameter_after_the_weight_is_invalid", "note": "a parameter after the weight fails, because nothing follows a weight", "rules": ["NG-5.5", "NG-5.7"], "lines": ["Text/HTML; Level=1; Q=0.5; x=y, */*"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_name_after_the_weight_is_invalid", "note": "a name without a value after the weight fails", "rules": ["NG-5.5", "NG-5.7"], "lines": ["text/html;q=0.5;flag"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_semicolon_after_the_weight_is_invalid", "note": "a semicolon after the weight fails", "rules": ["NG-5.5", "NG-5.7"], "lines": ["text/html;q=0.5;"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "white_space_after_the_weight_is_allowed", "note": "spaces and tabs after the weight and before the comma are allowed", "rules": ["NG-5.3", "NG-5.5"], "lines": ["text/html;q=0.5 \t, text/plain"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 500}, {"type": "text", "subtype": "plain", "parameters": [], "weight": 1000}] },
    { "id": "a_parameter_named_like_q_is_a_parameter", "note": "a parameter whose name only starts with q is a parameter", "rules": ["NG-5.5"], "lines": ["text/html;qq=1"], "ranges": [{"type": "text", "subtype": "html", "parameters": [{"name": "qq", "value": "1"}], "weight": 1000}] },
    { "id": "a_quoted_value_unquotes_its_pairs_and_keeps_its_commas", "note": "a quoted value unquotes its quoted pairs and keeps its commas", "rules": ["NG-3.3", "NG-3.4"], "lines": ["text/html;x=\"a,b\\\"c\""], "ranges": [{"type": "text", "subtype": "html", "parameters": [{"name": "x", "value": "a,b\"c"}], "weight": 1000}] },
    { "id": "an_empty_quoted_value_is_the_empty_value", "note": "a quoted string of no byte is the empty value", "rules": ["NG-3.3", "NG-3.4"], "lines": ["text/html;x=\"\""], "ranges": [{"type": "text", "subtype": "html", "parameters": [{"name": "x", "value": ""}], "weight": 1000}] },
    { "id": "obs_text_in_a_quoted_value_is_kept", "note": "a byte above 0x7F in a quoted string, alone or after a backslash, is kept", "rules": ["NG-1.4", "NG-3.3", "NG-3.4"], "lines": ["text/html;x=\"é\\ÿ\""], "ranges": [{"type": "text", "subtype": "html", "parameters": [{"name": "x", "value": "éÿ"}], "weight": 1000}] },
    { "id": "obs_text_outside_a_quoted_string_is_invalid", "note": "a byte above 0x7F is no token byte", "rules": ["NG-2.1", "NG-5.7"], "lines": ["text/html;x=é"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_control_byte_in_a_quoted_string_is_invalid", "note": "a control byte is no qdtext", "rules": ["NG-3.3", "NG-5.7"], "lines": ["text/html;x=\"a\u0001\""], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_quoted_line_feed_is_invalid", "note": "a line feed is neither qdtext nor the byte of a quoted pair", "rules": ["NG-3.3", "NG-5.7"], "lines": ["text/html;x=\"a\\\n\""], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_quote_after_a_token_value_is_invalid", "note": "a quote after a token value fails", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;x=a\"b\""], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_list_keeps_the_order_of_its_ranges", "note": "a list keeps the order of its ranges", "rules": ["NG-5.2"], "lines": ["text/html;q=0.5, application/vnd.hyper+json;q=0.9"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 500}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "weight": 900}] },
    { "id": "empty_list_elements_are_ignored", "note": "empty list elements and the whitespace around commas are ignored", "rules": ["NG-5.3"], "lines": [", text/html ,, application/vnd.hyper+json,"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}, {"type": "application", "subtype": "vnd.hyper+json", "parameters": [], "weight": 1000}] },
    { "id": "white_space_around_a_line_is_ignored", "note": "spaces and tabs around a field line value are ignored", "rules": ["NG-1.5"], "lines": [" \t text/html \t"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}] },
    { "id": "two_field_lines_give_their_ranges_in_order", "note": "the ranges of a field are the ranges of its lines in line order", "rules": ["NG-5.2"], "lines": ["text/html", "application/json;q=0.5"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}, {"type": "application", "subtype": "json", "parameters": [], "weight": 500}] },
    { "id": "an_empty_line_among_lines_gives_no_range", "note": "an empty field line among others gives no range", "rules": ["NG-5.2", "NG-5.3"], "lines": ["", "text/html"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}] },
    { "id": "a_quoted_string_does_not_continue_into_the_next_line", "note": "a quoted string that a field line leaves open fails, also when the next line would close it", "rules": ["NG-3.3", "NG-5.2", "NG-5.7"], "lines": ["text/html;x=\"a", "b\""], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "one_failing_line_fails_the_field", "note": "a field with one failing line fails", "rules": ["NG-5.7"], "lines": ["text/html", "text/plain;q=2"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "a_qvalue_of_zero_is_weight_zero", "note": "q=0 is weight 0", "rules": ["NG-6.2", "NG-6.3"], "lines": ["text/html;q=0"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 0}] },
    { "id": "zero_with_a_point_is_weight_zero", "note": "q=0. is weight 0", "rules": ["NG-6.1", "NG-6.2"], "lines": ["text/html;q=0."], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 0}] },
    { "id": "a_qvalue_has_up_to_three_decimals", "note": "q=0.123 is weight 123", "rules": ["NG-6.1", "NG-6.2"], "lines": ["text/html;q=0.123"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 123}] },
    { "id": "fewer_decimals_are_thousandths", "note": "q=0.05 is weight 50", "rules": ["NG-6.2"], "lines": ["text/html;q=0.05"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 50}] },
    { "id": "one_with_three_zero_decimals_is_a_qvalue", "note": "q=1.000 is weight 1000", "rules": ["NG-6.1", "NG-6.2"], "lines": ["text/html;q=1.000"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}] },
    { "id": "one_with_a_point_is_a_qvalue", "note": "q=1. is weight 1000", "rules": ["NG-6.1", "NG-6.2"], "lines": ["text/html;q=1."], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}] },
    { "id": "q_x_is_invalid", "note": "q=x is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=x"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "q_above_one_is_invalid", "note": "q=1.5 is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=1.5"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "one_with_a_nonzero_decimal_is_invalid", "note": "q=1.001 is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=1.001"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "four_decimals_are_invalid", "note": "a qvalue with four decimals is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=0.1234"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "a_leading_point_is_invalid", "note": "q=.5 is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=.5"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "a_sign_is_invalid", "note": "q=-0 is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=-0"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "a_quoted_qvalue_is_invalid", "note": "a quoted qvalue is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=\"0.5\""], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "an_empty_qvalue_is_invalid", "note": "q= without digits is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q="], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "a_text_after_a_qvalue_is_invalid", "note": "q=0.5x is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q=0.5x"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "q_without_an_equal_sign_is_invalid", "note": "q without = fails the grammar", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;q"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_space_around_the_equal_sign_of_q_is_invalid", "note": "a space before the = of q fails the grammar", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;q = 0.5"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_space_after_the_equal_sign_of_q_is_invalid", "note": "a space after the = of q is no qvalue", "rules": ["NG-6.1", "NG-5.7"], "lines": ["text/html;q= 0.5"], "raises": {"kind": "invalid_weight", "status": 400, "category": "value", "message": null} },
    { "id": "a_range_without_a_subtype_is_invalid", "note": "a range without a subtype fails", "rules": ["NG-5.4", "NG-5.7"], "lines": ["text"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_range_with_an_empty_subtype_is_invalid", "note": "a range with a slash and no subtype fails", "rules": ["NG-5.4", "NG-5.7"], "lines": ["text/"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_wildcard_type_with_a_subtype_is_invalid", "note": "*/html fails", "rules": ["NG-5.4", "NG-5.7"], "lines": ["*/html"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_trailing_semicolon_is_an_empty_parameter", "note": "a trailing semicolon is an empty parameter", "rules": ["NG-3.2"], "lines": ["text/html;"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}] },
    { "id": "empty_parameters_are_ignored", "note": "empty parameters and the whitespace around semicolons give nothing", "rules": ["NG-3.2", "NG-5.5"], "lines": ["text/html \t; ;level=1 ;;\tq=0.5"], "ranges": [{"type": "text", "subtype": "html", "parameters": [{"name": "level", "value": "1"}], "weight": 500}] },
    { "id": "an_empty_parameter_before_a_comma_is_allowed", "note": "a semicolon before the comma is an empty parameter", "rules": ["NG-3.2"], "lines": ["text/html; , text/plain"], "ranges": [{"type": "text", "subtype": "html", "parameters": [], "weight": 1000}, {"type": "text", "subtype": "plain", "parameters": [], "weight": 1000}] },
    { "id": "a_wildcard_range_keeps_its_parameters", "note": "a range */* keeps its parameters", "rules": ["NG-5.4"], "lines": ["*/*;format=flowed"], "ranges": [{"type": "*", "subtype": "*", "parameters": [{"name": "format", "value": "flowed"}], "weight": 1000}] },
    { "id": "a_parameter_without_a_value_is_invalid", "note": "a parameter without = fails", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;level"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_parameter_with_an_empty_value_is_invalid", "note": "a parameter with = and no value fails", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;level="], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_space_before_the_equal_sign_is_invalid", "note": "a space before = fails", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;level =1"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_space_after_the_equal_sign_is_invalid", "note": "a space after = fails", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;level= 1"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_quoted_parameter_name_is_invalid", "note": "a parameter name is a token, not a quoted string", "rules": ["NG-3.1", "NG-5.7"], "lines": ["text/html;\"level\"=1"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "an_unterminated_quoted_string_is_invalid", "note": "a quoted string without its closing quote fails", "rules": ["NG-3.3", "NG-5.7"], "lines": ["text/html;x=\"a"], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
    { "id": "a_backslash_at_the_end_of_a_quoted_string_is_invalid", "note": "a backslash before the end of the line leaves the quoted string open", "rules": ["NG-3.3", "NG-5.7"], "lines": ["text/html;x=\"a\\\""], "raises": {"kind": "invalid_accept", "status": 400, "category": "value", "message": null} },
