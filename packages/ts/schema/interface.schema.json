{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polyspec/bindgen/schema/interface.schema.json",
  "title": "polyspec interface contract",
  "description": "The public API of one repository in every target language (bindgen design I-1). Rule ids in descriptions are those of docs/spec/contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "library", "core", "targets", "packages", "naming", "types", "errors", "units", "changes", "cases"],
  "properties": {
    "schema": { "const": "polyspec/interface@1" },
    "library": { "$ref": "#/$defs/library" },
    "core": {
      "description": "The core crate (I-1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["crate", "path"],
      "properties": {
        "crate": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "targets": {
      "description": "The targets that the repository generates (I-4).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lang" }
    },
    "packages": { "$ref": "#/$defs/packages" },
    "naming": {
      "description": "Names that differ from the conversion of N-2 (N-3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptions"],
      "properties": {
        "exceptions": { "type": "array", "items": { "$ref": "#/$defs/namingException" } }
      }
    },
    "types": {
      "description": "The value types (T-3) that this contract uses by name, each with the library and the value unit that own it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "json_value": { "$ref": "#/$defs/valueTypeOwner" },
        "template_value": { "$ref": "#/$defs/valueTypeOwner" },
        "php_value": { "$ref": "#/$defs/valueTypeOwner" }
      }
    },
    "errors": { "$ref": "#/$defs/errors" },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "library": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "lang": { "enum": ["php", "python", "node", "go", "wasm"] },
    "ruleId": {
      "description": "A rule id, the only accepted form of a reason (N-3, T-5, I-3, E-1b, U-3, Q-4, C-1).",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]*-?[0-9]+[a-z]?(\\.[0-9]+)*$"
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "relativePath": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
    "rustPath": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$" },
    "word": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["acronym"],
          "properties": { "acronym": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" } }
        }
      ]
    },
    "name": {
      "description": "A name as a list of words (N-1).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/word" }
    },
    "module": {
      "description": "A neutral module path (P-2); its first segment is not host or tests (L-1).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*$"
    },
    "only": {
      "description": "The targets where the item exists, with the rule that removes it from the others (Q-4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "reason"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/lang" } },
        "reason": { "$ref": "#/$defs/ruleId" }
      }
    },
    "native": {
      "description": "A type-level declaration that the generator cannot compute, per language (I-3).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(php|python|node|go|wasm)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signature", "reason"],
          "properties": {
            "signature": { "type": "string", "minLength": 1 },
            "reason": { "$ref": "#/$defs/ruleId" }
          }
        }
      }
    },
    "packages": {
      "description": "Package names, roots and entries per language (P-1, P-5, P-6).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "php": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "namespace"],
          "properties": {
            "package": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
            "namespace": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\\\[A-Z][A-Za-z0-9]*)*$" }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "module"],
          "properties": {
            "package": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "module": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$" }
          }
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "entries"],
          "properties": {
            "package": { "type": "string", "pattern": "^(@[a-z0-9-]+/)?[a-z0-9-]+$" },
            "entries": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^\\.(/[a-z0-9_-]+)*$" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["formats"],
                "properties": {
                  "conditions": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["node", "browser"],
                    "properties": { "node": { "const": "napi" }, "browser": { "const": "wasm" } }
                  },
                  "formats": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["import", "require"] }
                  }
                }
              }
            }
          }
        },
        "go": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module"],
          "properties": { "module": { "type": "string", "pattern": "^[a-z0-9.-]+(/[A-Za-z0-9._-]+)+$" } }
        },
        "reexport": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "unit"],
            "properties": { "from": { "$ref": "#/$defs/library" }, "unit": { "$ref": "#/$defs/id" } }
          }
        }
      }
    },
    "namingException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lang", "unit", "name", "reason"],
      "properties": {
        "lang": { "$ref": "#/$defs/lang" },
        "unit": { "$ref": "#/$defs/id" },
        "member": { "$ref": "#/$defs/id" },
        "parameter": { "$ref": "#/$defs/name" },
        "field": { "$ref": "#/$defs/name" },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "reason": { "$ref": "#/$defs/ruleId" }
      },
      "not": { "required": ["parameter", "field"] }
    },
    "valueTypeOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "unit"],
      "properties": { "library": { "$ref": "#/$defs/library" }, "unit": { "$ref": "#/$defs/id" } }
    },
    "type": {
      "description": "A contract type (T-1, T-2, T-3).",
      "oneOf": [
        {
          "enum": [
            "bool", "int", "int64", "uint", "float", "text", "latin1", "bytes", "source", "path", "none", "never",
            "self", "cancel", "host_value", "json_value", "template_value", "php_value"
          ]
        },
        { "type": "object", "additionalProperties": false, "required": ["list"], "properties": { "list": { "$ref": "#/$defs/type" } } },
        { "type": "object", "additionalProperties": false, "required": ["map"], "properties": { "map": { "$ref": "#/$defs/type" } } },
        { "type": "object", "additionalProperties": false, "required": ["optional"], "properties": { "optional": { "$ref": "#/$defs/type" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tuple"],
          "properties": { "tuple": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/type" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function": {
              "type": "object",
              "additionalProperties": false,
              "required": ["parameters", "returns"],
              "properties": {
                "parameters": { "type": "array", "items": { "$ref": "#/$defs/type" } },
                "returns": { "$ref": "#/$defs/type" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["passthrough"],
          "properties": { "passthrough": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "properties": { "unit": { "$ref": "#/$defs/id" }, "library": { "$ref": "#/$defs/library" } }
        }
      ]
    },
    "category": { "enum": ["value", "type", "io", "store", "busy", "internal"] },
    "bindingKind": {
      "enum": [
        "invalid_number", "invalid_text", "invalid_path", "direct_construction", "invalid_callback", "consumed",
        "invalid_argument_type", "busy", "wrong_thread", "internal"
      ]
    },
    "errors": {
      "description": "Error kinds, categories and classes (E-1 to E-2, E-1a, E-1b).",
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "fixed", "kinds", "binding", "wrapped"],
      "properties": {
        "classes": {
          "description": "The base class of every category in every language but Go, whose category types E-7 fixes (E-2).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "$ref": "#/$defs/classRow" },
            "type": { "$ref": "#/$defs/classRow" },
            "io": { "$ref": "#/$defs/classRow" },
            "store": { "$ref": "#/$defs/classRow" },
            "busy": { "$ref": "#/$defs/classRow" },
            "internal": { "$ref": "#/$defs/classRow" }
          }
        },
        "fixed": {
          "description": "The runtime argument errors of G-7, classes with no kind and category type (E-2).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lang", "class"],
            "properties": { "lang": { "$ref": "#/$defs/lang" }, "class": { "$ref": "#/$defs/className" } }
          }
        },
        "kinds": {
          "description": "The variants of the core error enum (E-1); a variant of a dependency names its library and takes its category from that contract (E-1b).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variant"],
            "properties": {
              "variant": { "$ref": "#/$defs/rustPath" },
              "category": { "$ref": "#/$defs/category" },
              "library": { "$ref": "#/$defs/library" },
              "class": { "$ref": "#/$defs/id" }
            },
            "oneOf": [{ "required": ["category"], "not": { "required": ["library"] } }, { "required": ["library"], "not": { "required": ["category"] } }]
          }
        },
        "binding": {
          "description": "Class overrides of the kinds of BindingError (E-1a, E-2).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "class"],
            "properties": { "kind": { "$ref": "#/$defs/bindingKind" }, "class": { "$ref": "#/$defs/id" } }
          }
        },
        "wrapped": {
          "description": "For each property of each error unit of a wrapped dependency: forward it or drop it with a rule (E-1b).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["library", "unit", "property"],
            "properties": {
              "library": { "$ref": "#/$defs/library" },
              "unit": { "$ref": "#/$defs/id" },
              "property": { "$ref": "#/$defs/name" },
              "forward": { "$ref": "#/$defs/id" },
              "drop": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reason"],
                "properties": { "reason": { "$ref": "#/$defs/ruleId" } }
              }
            },
            "oneOf": [{ "required": ["forward"] }, { "required": ["drop"] }]
          }
        }
      }
    },
    "className": { "type": "string", "pattern": "^[A-Za-z_\\\\][A-Za-z0-9_.\\\\]*$" },
    "classRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "php": { "$ref": "#/$defs/className" },
        "python": { "$ref": "#/$defs/className" },
        "node": { "$ref": "#/$defs/className" },
        "wasm": { "$ref": "#/$defs/className" }
      }
    },
    "valueKind": {
      "description": "bindgen_core::ValueKind.",
      "oneOf": [
        { "enum": ["null", "bool", "int", "int64", "float", "number", "text", "bytes", "list", "map", "object", "safe_text", "native"] },
        { "enum": ["nested:json_value", "nested:template_value", "nested:php_value"] }
      ]
    },
    "builtinForm": { "enum": ["null", "bool", "int", "bigint", "float", "text", "bytes", "list", "map"] },
    "outRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "make"],
      "properties": {
        "kind": { "$ref": "#/$defs/valueKind" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["predicate", "is"],
          "properties": {
            "predicate": { "enum": ["utf8", "sequence_keys", "safe_integer", "integral_float"] },
            "is": { "type": "boolean" }
          }
        },
        "make": {
          "description": "Per language: a built-in form or the id of a public constructor or static factory of a value unit.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^(php|python|node|go|wasm)$": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value"],
                  "properties": { "value": { "enum": ["json_value", "template_value", "php_value"] } }
                }
              ]
            }
          }
        }
      }
    },
    "inRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases"],
      "properties": {
        "php": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "go": { "type": "string", "minLength": 1 },
        "wasm": { "type": "string", "minLength": 1 },
        "by": { "$ref": "#/$defs/id" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "is": { "type": "string" },
              "kind": { "$ref": "#/$defs/valueKind" },
              "read": { "$ref": "#/$defs/id" }
            }
          }
        }
      },
      "oneOf": [
        { "required": ["php"] }, { "required": ["python"] }, { "required": ["node"] }, { "required": ["go"] }, { "required": ["wasm"] }
      ]
    },
    "default": {
      "description": "A declared default (U-2).",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": { "type": ["string", "number", "boolean", "null"] } } },
        { "type": "object", "additionalProperties": false, "required": ["const"], "properties": { "const": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["empty"], "properties": { "empty": { "enum": ["map", "list", "object"] } } },
        { "type": "object", "additionalProperties": false, "required": ["computed"], "properties": { "computed": { "$ref": "#/$defs/ruleId" } } }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" },
        "required": { "const": true },
        "default": { "$ref": "#/$defs/default" },
        "default_core": { "$ref": "#/$defs/rustPath" },
        "rest": { "const": true },
        "only": { "$ref": "#/$defs/only" }
      },
      "oneOf": [{ "required": ["required"] }, { "required": ["default"] }, { "required": ["rest"] }]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" },
        "required": { "const": true },
        "default": { "$ref": "#/$defs/default" },
        "default_core": { "$ref": "#/$defs/rustPath" },
        "only": { "$ref": "#/$defs/only" }
      },
      "oneOf": [{ "required": ["required"] }, { "required": ["default"] }]
    },
    "callbackErrors": {
      "description": "The classes whose instances a callback's language code may raise to give the core a known result (U-3); every other exception goes back to the caller unchanged.",
      "type": "object",
      "additionalProperties": false,
      "required": ["recognize", "reason"],
      "properties": {
        "recognize": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unitRef" } },
        "reason": { "$ref": "#/$defs/ruleId" }
      }
    },
    "unitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": { "unit": { "$ref": "#/$defs/id" }, "library": { "$ref": "#/$defs/library" } }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "kind": {
          "enum": [
            "constructor", "method", "static", "function", "property", "constant", "invoke", "iterate", "stringify",
            "to_json", "primitive", "no_clone", "no_serialize"
          ]
        },
        "visibility": { "enum": ["public", "internal"] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "returns": { "$ref": "#/$defs/type" },
        "optional_reason": { "$ref": "#/$defs/ruleId" },
        "yields": {
          "oneOf": [
            { "$ref": "#/$defs/type" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": { "key": { "$ref": "#/$defs/type" }, "value": { "$ref": "#/$defs/type" } }
            }
          ]
        },
        "raises": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/rustPath" } },
        "wait": { "enum": ["none", "blocking_io", "process_wait", "async_driver"] },
        "core": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "$ref": "#/$defs/rustPath" },
                "receiver": { "enum": ["self", "&self", "&mut self"] }
              }
            },
            { "$ref": "#/$defs/rustPath" }
          ]
        },
        "type": { "$ref": "#/$defs/type" },
        "value": { "type": ["string", "number", "boolean"] },
        "writable": { "type": "boolean" },
        "async_allowed": { "type": "boolean" },
        "errors": { "$ref": "#/$defs/callbackErrors" },
        "only": { "$ref": "#/$defs/only" },
        "native": { "$ref": "#/$defs/native" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "constant" } } },
          "then": {
            "required": ["type", "value", "core"],
            "properties": { "core": { "$ref": "#/$defs/rustPath" } },
            "not": { "anyOf": [{ "required": ["parameters"] }, { "required": ["returns"] }, { "required": ["wait"] }] }
          },
          "else": {
            "not": { "anyOf": [{ "required": ["type"] }, { "required": ["value"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "iterate" } } },
          "then": { "required": ["yields"] },
          "else": { "not": { "required": ["yields"] } }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "module", "kind", "visibility", "origin"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "module": { "$ref": "#/$defs/module" },
        "kind": { "enum": ["class", "variant", "functions", "interface", "record", "enum", "error"] },
        "visibility": { "enum": ["public", "internal"] },
        "origin": { "enum": ["generated", "host", "callback", "value"] },
        "category": { "$ref": "#/$defs/category" },
        "parent": { "$ref": "#/$defs/id" },
        "core_type": { "$ref": "#/$defs/rustPath" },
        "core": { "$ref": "#/$defs/rustPath" },
        "thread": { "enum": ["any", "owner"] },
        "cleanup": { "$ref": "#/$defs/id" },
        "constructible": { "type": "boolean" },
        "implements": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/unitRef" } },
        "final": { "type": "boolean" },
        "abstract": { "type": "boolean" },
        "only": { "$ref": "#/$defs/only" },
        "native": { "$ref": "#/$defs/native" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": { "name": { "$ref": "#/$defs/name" }, "value": { "type": "string", "minLength": 1 } }
          }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "tag": { "$ref": "#/$defs/name" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "fields"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
            }
          }
        },
        "out": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outRow" } },
        "in": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inRow" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "enum" } } }, "then": { "required": ["variants"] }, "else": { "not": { "required": ["variants"] } } },
        { "if": { "properties": { "kind": { "const": "record" } } }, "then": { "required": ["fields"] }, "else": { "not": { "required": ["fields"] } } },
        {
          "if": { "properties": { "kind": { "const": "variant" } } },
          "then": { "required": ["tag", "cases"] },
          "else": { "not": { "anyOf": [{ "required": ["tag"] }, { "required": ["cases"] }] } }
        },
        {
          "if": { "properties": { "origin": { "const": "callback" } } },
          "then": { "required": ["core", "thread"] },
          "else": { "not": { "anyOf": [{ "required": ["core"] }, { "required": ["thread"] }] } }
        },
        {
          "if": { "properties": { "origin": { "const": "value" } } },
          "then": { "required": ["out", "in"] },
          "else": { "not": { "anyOf": [{ "required": ["out"] }, { "required": ["in"] }] } }
        }
      ]
    },
    "change": {
      "description": "A difference from the API of the base commit (C-1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "reason", "symbol", "from", "to"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "rule": { "$ref": "#/$defs/ruleId" },
        "reason": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^(php|python|node|go|wasm)$": { "type": "string" } }
        },
        "to": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "case": {
      "description": "The contract case file and group that run a member (K-1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "file", "group"],
      "properties": {
        "member": { "$ref": "#/$defs/id" },
        "file": { "$ref": "#/$defs/relativePath" },
        "group": { "type": "string", "minLength": 1 }
      }
    }
  }
}
