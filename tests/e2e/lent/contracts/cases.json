{
  "keep": [
    {
      "id": "the_lookup_of_the_search_gives_the_value",
      "search": {
        "lookup": {
          "callback": {
            "lookup.find": [
              {
                "args": {
                  "key": "a"
                },
                "result": "b"
              }
            ]
          }
        },
        "key": "a"
      },
      "result": "b"
    },
    {
      "id": "a_key_that_the_lookup_does_not_hold_is_missing",
      "search": {
        "lookup": {
          "callback": {
            "lookup.find": [
              {
                "args": {
                  "key": "a"
                },
                "result": null
              }
            ]
          }
        },
        "key": "a"
      },
      "raises": {
        "kind": "missing",
        "status": null,
        "category": "value",
        "message": "no value for a"
      }
    }
  ],
  "hold": [
    {
      "id": "a_kept_holding_gives_its_key",
      "holding": {
        "lookup": {
          "callback": {
            "lookup.find": []
          }
        },
        "key": "a"
      },
      "result": "a"
    },
    {
      "id": "a_holding_without_a_lookup_gives_its_key",
      "holding": {
        "key": "b"
      },
      "result": "b"
    }
  ]
}
