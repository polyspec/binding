#!/bin/sh
# The commit-msg hook. Git runs it with the file of the message being committed as its argument, before each commit, an amend
# included. The rules commit-ai-footer and commit-ai-identity of check-commits of kit refuse a message with the footer or the
# identity line of an AI tool. make hooks makes this file executable; the hook calls the make target of the check, which stays
# across the versions of kit.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec make --no-print-directory commit-msg-hook MESSAGE="$1"
